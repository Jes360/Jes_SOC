// ==============================================================================
// Detection: Successful Network Logon After Brute Force Authentication Failures (CORR-01)
// Canonical Source: correlations/mr_bruteforce_after_failures.yml
// Target Platform: Splunk Enterprise / Splunk Cloud
// Technology Add-on: Splunk_TA_windows (or standard XML Security Event Log)
// MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing), T1078.003 (Valid Accounts: Local Accounts)
// Severity: Critical
// ==============================================================================
//
// ARCHITECTURAL CORRELATION MAPPING:
// ------------------------------------------------------------------------------
// 1. Sigma Intent:
//    Correlates >= 5 network failed logons (Event 4625, LogonType 3) followed by
//    >= 1 successful network logon (Event 4624, LogonType 3) targeting the same
//    account from the same source IP within a 5-minute temporal window.
//
// 2. Splunk Implementation Approach:
//    Utilizes Splunk's native `transaction` command with `maxspan=5m`, enforcing
//    `startswith` (failure burst) and `endswith` (successful logon).
//    Additionally calculates failure event count to ensure threshold (>= 5) is met.
//
// 3. Operational Tuning & Noise Filtering:
//    Pre-filters machine accounts (*$) and Windows service identities at the
//    atomic event ingestion phase before transaction aggregation.
// ==============================================================================

index=winsec source="XmlWinEventLog:Security" (EventCode=4625 OR EventCode=4624) Logon_Type=3
NOT (Account_Name="*$" OR Account_Name="SYSTEM" OR Account_Name="ANONYMOUS LOGON" OR Account_Name="LOCAL SERVICE" OR Account_Name="NETWORK SERVICE" OR Account_Name="-" OR Account_Name="")
| rename Account_Name as TargetUserName, Source_Network_Address as IpAddress, ComputerName as Computer
| transaction TargetUserName IpAddress maxspan=5m startswith=(EventCode=4625) endswith=(EventCode=4624)
| eval failure_count=mvcount(mvfilter(match(EventCode, "4625")))
| eval success_count=mvcount(mvfilter(match(EventCode, "4624")))
| where failure_count >= 5 AND success_count >= 1
| eval alert_severity="critical", mitre_technique="T1110.001,T1078.003"
| table _time, TargetUserName, IpAddress, Computer, failure_count, success_count, duration, alert_severity, mitre_technique
